# Get your free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Get your free Mistral API key: https://console.mistral.ai
MISTRAL_API_KEY=

# Get your free Gemini API key: https://aistudio.google.com/apikey (optional)
GEMINI_API_KEY=

# Backend server settings
HOST=127.0.0.1
PORT=8001

# Local LLM (Ollama) - works fully offline, no API key needed
# Runs as the final fallback after Groq/Mistral
OLLAMA_ENABLED=1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Local neural TTS (Piper) - human-like voice, fully offline
# Run `bash scripts/setup_piper.sh` first, or these pick sensible defaults
# PIPER_BIN=/absolute/path/to/piper-venv/bin/piper
# PIPER_VOICE_DIR=/absolute/path/to/piper-venv/voices
# PIPER_MODEL=en_US-amy-medium.onnx
# PIPER_LENGTH_SCALE=1.1   # slightly slower = calmer
# Indian-language Piper voices: hi_IN-pratham-medium, te_IN-maya-medium,
# ml_IN-meera-medium, mr_IN-google-medium (auto-detected from the message).
# Every other Indian language (ta/bn/gu/kn/ur) uses online edge-tts.
# Fallback macOS `say` voice when Piper is unavailable
TTS_VOICE=Rishi

# Agora RTC (live classroom audio) - from `agora project env write` after
# `agora login` + `agora project create sahayak-live --feature rtc`
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Numeric uid (> 1e9) for the backend AI voice in every channel. 0x53414841 = "SAHA"
# AGORA_AI_UID=1396787265
# AI voice gain in the channel (0..1). 0.35 ≈ −9 dB: keeps the AI loud but
# never ear-blasting. Also add trailing silence + fades to avoid clicks.
# AGORA_AI_VOLUME=0.35
# Browser playback volume (0-100) the frontend uses for the AI's remote track.
# NEXT_PUBLIC_AGORA_AI_VOLUME=55

